<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet package source layout for KdpPublish.

  Two sources, intentionally ordered:

    1. lib/local-packages/  (relative to this file)
       Holds the private packages this repo depends on that aren't on nuget.org:
       AutoWebNav + AutoWebNav.WebView2 (the shared browser-automation toolkit),
       MindAttic.Export (ArtifactWriter, the shared user-facing file writer), and
       Prose.Core (KdpPublish was decoupled from the Prose monorepo 2026-10-04; it still
       needs Prose.Core's Kdp/Operator services and the Prose data model, so it consumes
       Prose.Core as a versioned package instead of a sibling project). The folder is
       checked into git so a build here never depends on the developer's other repos
       being checked out, let alone at a specific relative path.

    2. nuget.org
       Everything else. Standard public feed.

  When Prose.Core changes in a way this app needs, repack it from the Prose repo
  (`dotnet pack src/Prose.Core/Prose.Core.csproj -c Release -p:PackageVersion=X.Y.Z -o <tmp>`),
  drop the new .nupkg in lib/local-packages/, and bump the PackageReference version in
  KdpPublish.csproj. Old .nupkg files can stay in the folder — NuGet picks the
  version requested by the csproj.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-packages" value="./lib/local-packages" />
    <add key="nuget.org"      value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
