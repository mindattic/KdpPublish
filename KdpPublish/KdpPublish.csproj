<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Embedded into the .exe as its Win32 resource icon; WPF windows inherit it. -->
    <ApplicationIcon>..\assets\kdp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Decoupled from the Prose monorepo 2026-10-04 — Prose.Core is now a vendored package
         (see NuGet.config / lib/local-packages), not a sibling ProjectReference. Repack and
         bump the version here when this app needs a newer Prose.Core. -->
    <PackageReference Include="Prose.Core" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoWebNav.WebView2" Version="4.0.0" />
    <!-- ArtifactWriter for the tools/kdp diagnostic dumps; vendored in lib/local-packages. -->
    <PackageReference Include="MindAttic.Export" Version="3.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
